generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  customer
  admin
}

enum BookingStatus {
  pending
  confirmed
  cancelled
}

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique
  name      String
  timezone  String    @default("UTC")
  createdAt DateTime  @default(now()) @db.Timestamptz
  users     User[]
  services  Service[]
  bookings  Booking[]
  audit     AuditEvent[]
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  email          String
  name           String
  role           UserRole     @default(customer)
  createdAt      DateTime     @default(now()) @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id])
  bookings       Booking[]

  @@unique([organizationId, email])
}

model Service {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  slug            String
  name            String
  description     String
  durationMinutes Int
  priceMinor      Int
  currency        String       @db.Char(3)
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now()) @db.Timestamptz
  organization    Organization @relation(fields: [organizationId], references: [id])
  slots           Slot[]

  @@unique([organizationId, slug])
  @@index([organizationId, active])
}

model Slot {
  id        String    @id @default(uuid()) @db.Uuid
  serviceId String    @db.Uuid
  startsAt  DateTime  @db.Timestamptz
  endsAt    DateTime  @db.Timestamptz
  capacity  Int       @default(1)
  service   Service   @relation(fields: [serviceId], references: [id])
  bookings  Booking[]

  @@unique([serviceId, startsAt])
  @@index([startsAt])
}

model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  slotId         String        @db.Uuid
  userId         String        @db.Uuid
  status         BookingStatus @default(pending)
  notes          String?
  createdAt      DateTime      @default(now()) @db.Timestamptz
  updatedAt      DateTime      @updatedAt @db.Timestamptz
  organization   Organization  @relation(fields: [organizationId], references: [id])
  slot           Slot          @relation(fields: [slotId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([slotId])
}

// Idempotency records (contract: src/core/idempotency).
model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  key         String
  scope       String // `${capability}|${actorSubject}`
  requestHash String
  state       String    @default("done") // 'in_progress' | 'done' (CHECK constraint in migration)
  response    Json? // null while in_progress
  createdAt   DateTime  @default(now()) @db.Timestamptz
  /// done: record expiry
  expiresAt   DateTime  @db.Timestamptz
  /// in_progress: lease expiry (crashed claimants can be superseded after this)
  leaseExpiresAt DateTime? @db.Timestamptz

  @@unique([scope, key])
}

// Append-only audit log (contract: src/core/logging/audit.ts).
// Also in migrations (not modelled here): partial unique index Booking(slotId,userId) WHERE status<>'cancelled'.
model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String?      @db.Uuid
  occurredAt     DateTime     @default(now()) @db.Timestamptz
  requestId      String
  actorKind      String
  actorId        String?
  onBehalfOf     String?
  grantId        String?
  capability     String
  outcome        String
  resourceType   String?
  resourceId     String?
  inputHash      String?
  detail         Json?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, occurredAt])
  @@index([capability, occurredAt])
}

// Durable auth/security stores (migration 20261112000000_durable_auth_stores). See src/core/db/auth-stores.ts.
model AgentGrant {
  grantId   String    @id
  userId    String
  clientId  String
  scopes    String[]
  createdAt DateTime  @default(now()) @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz

  @@index([userId])
}

// Also in the migration (not modelled): CHECK status IN ('pending','approved','consumed','denied').
model AgentConfirmation {
  id         String   @id @db.Uuid
  subject    String
  userId     String
  capability String
  inputHash  String
  preview    String
  status     String   @default("pending")
  expiresAt  DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([subject, status, expiresAt])
  @@index([expiresAt])
}

model RateLimitWindow {
  key     String   @id
  count   Int
  resetAt DateTime @db.Timestamptz

  @@index([resetAt])
}

model ReplayEntry {
  id        String   @id
  expiresAt DateTime @db.Timestamptz

  @@index([expiresAt])
}

model LoginTransaction {
  state        String   @id
  nonce        String
  codeVerifier String
  returnTo     String
  expiresAt    DateTime @db.Timestamptz

  @@index([expiresAt])
}
