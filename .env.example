# Copy to .env.local. Never commit real secrets. Values below are local-dev only.
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://agenticweb:agenticweb_dev_only@localhost:5432/agenticweb
LOG_LEVEL=info
# Dev-only actor header resolver (x-dev-actor). MUST be false/unset in production; env validation rejects true in production.
DEV_AUTH_ENABLED=true
