# Copy to .env.local. Never commit real secrets. Values below are local-dev only.
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://agenticweb:agenticweb_dev_only@localhost:5432/agenticweb
LOG_LEVEL=info
# Dev-only actor header resolver (x-dev-actor). MUST be false/unset in production; env validation rejects true in production.
DEV_AUTH_ENABLED=true
# --- Authentication (see docs/authentication.md) ---
# Local dev without an IdP: in-process mock issuer (refused in production).
MOCK_ISSUER_ENABLED=true
# Production: OIDC issuer + (optional) JWKS URI; SESSION_SECRET (>=32 chars, random) is required.
# AUTH_ISSUER=https://idp.example.com
# AUTH_JWKS_URI=https://idp.example.com/.well-known/jwks.json
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
# Security state (grants, human confirmations, rate limits): postgres (default; required in production) or memory (per process).
AUTH_STORES=postgres
# Only true behind a proxy that overwrites x-forwarded-for.
TRUST_PROXY=false
RATE_LIMIT_ANON_PER_MIN=60
RATE_LIMIT_AUTH_PER_MIN=240
MAX_BODY_BYTES=65536
